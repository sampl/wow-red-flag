const gifRotations = [
  "-1.2deg",
  "0.8deg",
  "-0.6deg",
  "1.1deg",
  "-0.9deg",
  "0.5deg",
  "-1deg",
  "0.7deg",
  "-0.4deg",
  "1deg",
  "-0.7deg",
  "0.6deg",
  "-1.1deg",
  "0.4deg",
  "-0.8deg",
  "0.9deg",
  "-0.5deg",
];

// Split the flags into (interludeGifs.length + 1) segments as evenly as
// possible, so leftover flags are spread across the gaps instead of all
// landing after the last GIF. E.g. 11 flags over 2 GIFs -> [4, 4, 3], not
// [5, 5, 1].
const segmentCount = interludeGifs.length + 1;
const baseSegmentSize = Math.floor(redFlags.length / segmentCount);
const remainder = redFlags.length % segmentCount;

const gifPositions = new Map();
let cumulative = 0;
for (let gifIndex = 0; gifIndex < interludeGifs.length; gifIndex++) {
  cumulative += baseSegmentSize + (gifIndex < remainder ? 1 : 0);
  gifPositions.set(cumulative, gifIndex);
}
---

<BaseLayout
  title="Wow, red flag..."
  description="A list of patterns found in difficult relationships."
>
  <article class="content-card">
    <IntroHeader />

    <div class="tag-filters" role="group" aria-label="Filter by tag">
      {
        TAGS.map((tag) => (
          <button type="button" class="tag-pill" data-tag={tag.id} aria-pressed="false">
            <span class="tag-pill-label">{tag.label}</span>
            <span class="tag-pill-clear" aria-hidden="true">×</span>
          </button>
        ))
      }
    </div>

    <ul class="red-flag-list">
      {
        redFlags.map((flag, index) => {
          const gifIndex = gifPositions.get(index);
          const gif =
            gifIndex !== undefined ? interludeGifs[gifIndex] : undefined;
          const rotation =
            gifIndex !== undefined
              ? gifRotations[gifIndex % gifRotations.length]
              : undefined;

          return (
            <>
              {gif && (
                <li class="gif-slot" data-gif aria-hidden="true">
                  <figure
                    class="interlude-gif"
                    style={`--gif-rotation: ${rotation}`}
                  >
                    <GiphyEmbed {...gif} />
                  </figure>
                </li>
              )}
              <li
                class="red-flag"
                id={flag.id}
                data-aliases={flag.alternateNameLinks.map((link) => link.id).join(" ")}
                data-tags={flag.tags.join(" ")}
              >
                <strong>
                  <a href={`#${flag.id}`}>{flag.title}</a>
                </strong>
                {flag.alternateNameLinks.length > 0 && (
                  <span class="red-flag-aliases">
                    {" "}({flag.alternateNameLinks.map((link, aliasIndex) => (
                      <>
                        {aliasIndex > 0 && ", "}
                        <a href={`#${link.id}`}>{link.title}</a>
                      </>
                    ))})
                  </span>
                )}
                {" "}— {flag.description}
                {/* TODO: Restore the inline see-also links when they should be visible again. */}
              </li>
            </>
          );
        })
      }
    </ul>

    <SafetyNotice />
    <MoreResources />
  </article>
</BaseLayout>

<script>
  const pills = [...document.querySelectorAll(".tag-pill")].filter(
    (el) => el instanceof HTMLElement,
  );
  const flags = [...document.querySelectorAll(".red-flag")].filter(
    (el) => el instanceof HTMLElement,
  );
  const gifSlots = [...document.querySelectorAll(".gif-slot")].filter(
    (el) => el instanceof HTMLElement,
  );

  let activeTag = null;

  const applyFilter = () => {
    if (!activeTag) {
      flags.forEach((flag) => {
        flag.hidden = false;
      });
      gifSlots.forEach((slot) => {
        slot.hidden = false;
      });
      return;
    }

    gifSlots.forEach((slot) => {
      slot.hidden = true;
    });
    flags.forEach((flag) => {
      const tags = flag.dataset.tags?.split(" ") ?? [];
      flag.hidden = !tags.includes(activeTag);
    });
  };

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const tag = pill.dataset.tag ?? null;
      activeTag = activeTag === tag ? null : tag;
      pills.forEach((p) => {
        p.setAttribute("aria-pressed", String(p.dataset.tag === activeTag));
      });
      applyFilter();
    });
  });

  const resolveAliasHash = () => {
    const hash = decodeURIComponent(window.location.hash.slice(1));
    if (!hash || flags.some((flag) => flag.id === hash)) {
      return;
    }

    const target = flags.find((flag) =>
      (flag.dataset.aliases?.split(" ") ?? []).includes(hash),
    );
    if (!target) {
      return;
    }

    history.replaceState(null, "", `#${target.id}`);
    target.scrollIntoView({ block: "center" });
  };

  window.addEventListener("hashchange", resolveAliasHash);
  resolveAliasHash();
</script>
