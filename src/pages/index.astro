const gifRotations = [
  "-1.2deg",
  "0.8deg",
  "-0.6deg",
  "1.1deg",
  "-0.9deg",
  "0.5deg",
  "-1deg",
  "0.7deg",
  "-0.4deg",
  "1deg",
  "-0.7deg",
  "0.6deg",
  "-1.1deg",
  "0.4deg",
  "-0.8deg",
  "0.9deg",
  "-0.5deg",
];

// Split the flags into (interludeGifs.length + 1) segments as evenly as
// possible, so leftover flags are spread across the gaps instead of all
// landing after the last GIF. E.g. 11 flags over 2 GIFs -> [4, 4, 3], not
// [5, 5, 1].
const segmentCount = interludeGifs.length + 1;
const baseSegmentSize = Math.floor(redFlags.length / segmentCount);
const remainder = redFlags.length % segmentCount;

const gifPositions = new Map();
let cumulative = 0;
for (let gifIndex = 0; gifIndex < interludeGifs.length; gifIndex++) {
  cumulative += baseSegmentSize + (gifIndex < remainder ? 1 : 0);
  gifPositions.set(cumulative, gifIndex);
}
---

<BaseLayout
  title="Wow, red flag..."
  description="A list of patterns found in difficult relationships."
>
  <article class="content-card">
    <IntroHeader />
    <SafetyNotice />

    <div class="tag-filters" role="group" aria-label="Filter by tag">
      {
        TAGS.map((tag) => (
          <button type="button" class="tag-pill" data-tag={tag.id} aria-pressed="false">
            <span class="tag-pill-label">{tag.label}</span>
            <span class="tag-pill-clear" aria-hidden="true">×</span>
          </button>
        ))
      }
    </div>

    <ul class="red-flag-list">
      {
        redFlags.map((flag, index) => {
          const gifIndex = gifPositions.get(index);
          const gif =
            gifIndex !== undefined ? interludeGifs[gifIndex] : undefined;
          const rotation =
            gifIndex !== undefined
              ? gifRotations[gifIndex % gifRotations.length]
              : undefined;

          return (
            <>
              {gif && (
                <li class="gif-slot" data-gif aria-hidden="true" inert>
                  <figure
                    class="interlude-gif"
                    style={`--gif-rotation: ${rotation}`}
                  >
                    <GiphyEmbed {...gif} />
                  </figure>
                </li>
              )}
              <li
                class="red-flag"
                id={flag.id}
                data-aliases={flag.alternateNameLinks.map((link) => link.id).join(" ")}
                data-tags={flag.tags.join(" ")}
              >
                <strong>
                  <a href={`#${flag.id}`}>{flag.title}</a>
                </strong>
                {flag.alternateNameLinks.length > 0 && (
                  <span class="red-flag-aliases">
                    {" "}({flag.alternateNameLinks.map((link, aliasIndex) => (
                      <>
                        {aliasIndex > 0 && ", "}
                        <a href={`#${link.id}`}>{link.title}</a>
                      </>
                    ))})
                  </span>
                )}
                {" "}— {flag.description}
                {/* TODO: Restore the inline see-also links when they should be visible again. */}
              </li>
            </>
          );
        })
      }
    </ul>

    <MoreResources />
  </article>
</BaseLayout>

<script>
  import { createPatternBrowser } from "../patternBrowser";
  import { initializeDecorativeMedia } from "../decorativeMedia";

  const tagPills = [...document.querySelectorAll<HTMLButtonElement>(".tag-pill")];
  const patternElements = [...document.querySelectorAll<HTMLElement>(".red-flag")];
  const gifSlots = [...document.querySelectorAll<HTMLElement>(".gif-slot")];
  const gifFrames = [...document.querySelectorAll<HTMLIFrameElement>(".giphy-embed")];
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const browser = createPatternBrowser(patternElements.map((pattern) => ({
    id: pattern.id,
    aliases: pattern.dataset.aliases?.split(" ").filter(Boolean) ?? [],
    tags: pattern.dataset.tags?.split(" ").filter(Boolean) ?? [],
  })));

  const render = () => {
    const state = browser.snapshot();
    const visibleIds = new Set(state.visibleIds);
    for (const pattern of patternElements) pattern.hidden = !visibleIds.has(pattern.id);
    for (const pill of tagPills) {
      pill.setAttribute("aria-pressed", String(pill.dataset.tag === state.selectedTag));
    }
    for (const slot of gifSlots) slot.hidden = !!state.selectedTag || motionPreference.matches;
  };

  for (const pill of tagPills) {
    pill.addEventListener("click", () => {
      if (pill.dataset.tag) browser.toggleTag(pill.dataset.tag);
      render();
    });
  }
  const navigateToPattern = (fragment = window.location.hash) => {
    const navigation = browser.navigate(fragment);
    for (const pattern of patternElements) {
      pattern.toggleAttribute("data-linked-pattern", pattern.id === navigation?.targetId);
    }
    if (!navigation) return false;
    render();
    const canonicalHash = `#${navigation.targetId}`;
    if (window.location.hash !== canonicalHash) history.replaceState(null, "", canonicalHash);
    document.getElementById(navigation.targetId)?.scrollIntoView({ block: "center" });
    return true;
  };

  // Repeated clicks on the current fragment do not emit hashchange.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".red-flag a")) {
    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const fragment = link.hash;
      if (window.location.hash !== fragment) history.pushState(null, "", fragment);
      if (navigateToPattern(fragment)) event.preventDefault();
    });
  }
  window.addEventListener("hashchange", () => navigateToPattern(window.location.hash));
  window.addEventListener("popstate", () => navigateToPattern(window.location.hash));
  initializeDecorativeMedia(gifFrames, motionPreference, render);
  navigateToPattern(window.location.hash);
</script>
