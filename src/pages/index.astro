---
import { redFlagCategories } from "../data/redFlags";
import GiphyEmbed from "../components/GiphyEmbed.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const categoryIds = Object.fromEntries(
  redFlagCategories.map((category) => [
    category.title,
    `category-${category.title.toLowerCase().replaceAll(" ", "-")}`,
  ]),
);

const categoryGifs = [
  {
    embedUrl: "https://giphy.com/embed/9VnK2SUebgetTc9X7B",
    title: "Looney Tunes cartoon",
    paddingBottom: "75%",
  },
  {
    embedUrl: "https://giphy.com/embed/RrIz6d8Xyu9BqOnayr",
    title: "Tyler Reddick racing GIF",
    paddingBottom: "56%",
  },
  {
    embedUrl: "https://giphy.com/embed/dmwzK27KGMtHvLFRdi",
    title: "Red flags GIF",
    paddingBottom: "100%",
  },
  {
    embedUrl: "https://giphy.com/embed/9DAJde1hRtOYgrdeTU",
    title: "The Traitors GIF",
    paddingBottom: "100%",
  },
  {
    embedUrl: "https://giphy.com/embed/k4vs3VGJvdAqjdEHts",
    title: "Red flag GIF",
    paddingBottom: "100%",
  },
  {
    embedUrl: "https://giphy.com/embed/11JoiIqzlbUeE8",
    title: "Saturday Night Live GIF",
    paddingBottom: "75%",
  },
  {
    embedUrl: "https://giphy.com/embed/o56w7t0eIV8li",
    title: "Britney Spears pizza GIF",
    paddingBottom: "56%",
  },
  {
    embedUrl: "https://giphy.com/embed/BPTJJphmYwwhrpiX2W",
    title: "The Simpsons danger GIF",
    paddingBottom: "57%",
  },
  {
    embedUrl: "https://giphy.com/embed/3o7ZetIsjtbkgNE1I4",
    title: "Run away fast GIF",
    paddingBottom: "66%",
  },
  {
    embedUrl: "https://giphy.com/embed/3o6j8KqIw0Lgmt2Fsk",
    title: "BoJack Horseman rose-colored glasses GIF",
    paddingBottom: "60%",
  },
  {
    embedUrl: "https://giphy.com/embed/1n4iuWZFnTeN6qvdpD",
    title: "This is fine GIF",
    paddingBottom: "68%",
  },
  {
    embedUrl: "https://giphy.com/embed/q6sJQQf6brCefj0l1D",
    title: "Referee GIF",
    paddingBottom: "86%",
  },
  {
    embedUrl: "https://giphy.com/embed/5pMGZHSqfvGT5mnTwx",
    title: "Judge GIF",
    paddingBottom: "100%",
  },
  {
    embedUrl: "https://giphy.com/embed/8YEeD1WB5FeyAiONoe",
    title: "Schitt's Creek GIF",
    paddingBottom: "100%",
  },
];

const gifRotations = [
  "-1.2deg",
  "0.8deg",
  "-0.6deg",
  "1.1deg",
  "-0.9deg",
  "0.5deg",
  "-1deg",
  "0.7deg",
  "-0.4deg",
  "1deg",
  "-0.7deg",
  "0.6deg",
  "-1.1deg",
  "0.4deg",
];
---

<BaseLayout
  title="Wow, red flag..."
  description="A list of patterns found in difficult relationships."
>
  <article class="content-card">
    <header class="intro">
      <video
        class="logo"
        width="400"
        height="270"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
      >
        <source src="/red-flag.webm" type="video/webm" />
        <img src="/icon.png" width="160" height="160" alt="" />
      </video>
      <h1>“Wow, red flag…”</h1>
    </header>

    <p class="subheading">
      A list of behaviors and personality attributes commonly associated with
      toxic relationships.
    </p>

    <p>
      PLEASE NOTE: This site offers general educational information, NOT a
      diagnosis or medical, mental-health, legal, or professional advice. Every
      relationship and situation is different.
    </p>

    <aside class="safety-notice" aria-labelledby="safety-notice-title">
      <h2 id="safety-notice-title">Are you or a loved one in danger?</h2>
      <p>
        Call your local emergency number. In the United States, you can also
        contact the National Domestic Violence Hotline at <a
          href="tel:8007997233">800-799-7233</a
        >.
      </p>
    </aside>

    <nav class="table-of-contents" aria-label="Categories">
      <ul>
        {
          redFlagCategories.map((category) => (
            <li>
              <a href={`#${categoryIds[category.title]}`}>{category.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      redFlagCategories.map((category, index) => {
        const gif = categoryGifs[index % categoryGifs.length];
        const rotation = gifRotations[index % gifRotations.length];

        return (
          <div class="category-with-gif">
            <section
              class="red-flag-category"
              aria-labelledby={categoryIds[category.title]}
            >
              <h2 id={categoryIds[category.title]}>
                <a
                  class="heading-anchor"
                  href={`#${categoryIds[category.title]}`}
                  aria-label={`Link to ${category.title}`}
                >
                  #
                </a>
                {category.title}
              </h2>
              <ul>
                {category.flags.map((flag) => (
                  <li class="red-flag" id={flag.id}>
                    <strong>
                      <a href={`#${flag.id}`}>{flag.title}</a>
                    </strong>{" "}
                    — {flag.description}
                  </li>
                ))}
              </ul>
            </section>

            <figure class="category-gif" style={`--gif-rotation: ${rotation}`}>
              <GiphyEmbed {...gif} />
            </figure>
          </div>
        );
      })
    }

    <hr />

    <section aria-labelledby="resources">
      <h2 id="resources">
        <a
          class="heading-anchor"
          href="#resources"
          aria-label="Link to More resources">#</a
        >
        More resources
      </h2>
      <ul>
        <li>
          <a href="https://www.highconflictinstitute.com/podcast/"
            >It’s All Your Fault: High Conflict People podcast</a
          >
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>
