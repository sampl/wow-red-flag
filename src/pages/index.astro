  {
    embedUrl: "https://giphy.com/embed/3o6j8KqIw0Lgmt2Fsk",
    title: "BoJack Horseman rose-colored glasses GIF",
    paddingBottom: "60%",
  },
];

const gifRotations = [
  "-1.2deg",
  "0.8deg",
  "-0.6deg",
  "1.1deg",
  "-0.9deg",
  "0.5deg",
  "-1deg",
  "0.7deg",
  "-0.4deg",
  "1deg",
  "-0.7deg",
  "0.6deg",
  "-1.1deg",
  "0.4deg",
  "-0.8deg",
  "0.9deg",
  "-0.5deg",
];

// Split the flags into (interludeGifs.length + 1) segments as evenly as
// possible, so leftover flags are spread across the gaps instead of all
// landing after the last GIF. E.g. 11 flags over 2 GIFs -> [4, 4, 3], not
// [5, 5, 1].
const segmentCount = interludeGifs.length + 1;
const baseSegmentSize = Math.floor(redFlags.length / segmentCount);
const remainder = redFlags.length % segmentCount;

const gifPositions = new Map();
let cumulative = 0;
for (let gifIndex = 0; gifIndex < interludeGifs.length; gifIndex++) {
  cumulative += baseSegmentSize + (gifIndex < remainder ? 1 : 0);
  gifPositions.set(cumulative, gifIndex);
}
---

<BaseLayout
  title="Wow, red flag..."
  description="A list of patterns found in difficult relationships."
>
  <article class="content-card">
    <header class="intro">
      <img class="logo" src="/icon.png" width="160" height="160" alt="A red flag" />
      <h1>“Wow, red flag…”</h1>
      <p class="subheading">
        Behaviors & personality attributes of toxic relationships
      </p>
    </header>

    <div class="tag-filters" role="group" aria-label="Filter by tag">
      {
        TAGS.map((tag) => (
          <button type="button" class="tag-pill" data-tag={tag.id} aria-pressed="false">
            <span class="tag-pill-label">{tag.label}</span>
            <span class="tag-pill-clear" aria-hidden="true">×</span>
          </button>
        ))
      }
    </div>

    <ul class="red-flag-list">
      {
        redFlags.map((flag, index) => {
          const gifIndex = gifPositions.get(index);
          const gif =
            gifIndex !== undefined ? interludeGifs[gifIndex] : undefined;
          const rotation =
            gifIndex !== undefined
              ? gifRotations[gifIndex % gifRotations.length]
              : undefined;

          return (
            <>
              {gif && (
                <li class="gif-slot" data-gif aria-hidden="true">
                  <figure
                    class="interlude-gif"
                    style={`--gif-rotation: ${rotation}`}
                  >
                    <GiphyEmbed {...gif} />
                  </figure>
                </li>
              )}
              <li class="red-flag" id={flag.id} data-tags={flag.tags.join(" ")}>
                <strong>
                  <a href={`#${flag.id}`}>{flag.title}</a>
                </strong>{" "}
                — {flag.description}
              </li>
            </>
          );
        })
      }
    </ul>

    <aside class="safety-notice" aria-label="Are you or a loved one in danger?">
      <p>
        This site offers general educational information, not a diagnosis or
        medical, mental-health, legal, or professional advice. Every
        relationship and situation is different.
      </p>
      <p>
        <strong>Are you or a loved one in danger?</strong> Call your local
        emergency number, or the US National Domestic Violence Hotline at <a
          href="tel:8007997233">800-799-7233</a
        >.
      </p>
    </aside>

    <section aria-labelledby="resources">
      <h2 id="resources">
        <a
          class="heading-anchor"
          href="#resources"
          aria-label="Link to More resources">#</a
        >
        More resources
      </h2>
      <ul>
        <li>
          <a href="https://www.highconflictinstitute.com/podcast/"
            >It’s All Your Fault: High Conflict People podcast</a
          >
        </li>
        <li>
          <a href="https://www.jeffersonfisher.com/podcast"
            >The Jefferson Fisher Podcast</a
          >
        </li>
        <li>
          <a href="https://www.reddit.com/r/BPDlovedones/">r/BPDlovedones</a>
        </li>
        <li>
          <a href="https://www.youtube.com/@DoctorRamani"
            >Dr. Ramani on YouTube</a>
        </li>
        <li>
          <a href="https://www.hbo.com/the-vow"
            >The Vow — HBO documentary series</a
          >
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<script>
  const pills = [...document.querySelectorAll(".tag-pill")].filter(
    (el) => el instanceof HTMLElement,
  );
  const flags = [...document.querySelectorAll(".red-flag")].filter(
    (el) => el instanceof HTMLElement,
  );
  const gifSlots = [...document.querySelectorAll(".gif-slot")].filter(
    (el) => el instanceof HTMLElement,
  );

  let activeTag = null;

  const applyFilter = () => {
    if (!activeTag) {
      flags.forEach((flag) => {
        flag.hidden = false;
      });
      gifSlots.forEach((slot) => {
        slot.hidden = false;
      });
      return;
    }

    gifSlots.forEach((slot) => {
      slot.hidden = true;
    });
    flags.forEach((flag) => {
      const tags = flag.dataset.tags?.split(" ") ?? [];
      flag.hidden = !tags.includes(activeTag);
    });
  };

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const tag = pill.dataset.tag ?? null;
      activeTag = activeTag === tag ? null : tag;
      pills.forEach((p) => {
        p.setAttribute("aria-pressed", String(p.dataset.tag === activeTag));
      });
      applyFilter();
    });
  });
</script>
